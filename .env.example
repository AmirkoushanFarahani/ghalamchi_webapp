# Copy this file to .env. Every value containing change-me is a non-secret placeholder.
# Generate unique production secrets; never commit the resulting .env file.
APP_ENV=development
APP_NAME=Azari Intelligent Accounting
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://azari:change-me@db:5432/azari
POSTGRES_DB=azari
POSTGRES_USER=azari
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-use-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_ACCOUNT_RATE_LIMIT_ATTEMPTS=20
MAX_REQUEST_BYTES=1048576
# Production uses shared PostgreSQL authentication counters across workers.
# APP_ENV=production also disables API docs and rejects placeholder JWT secrets.
# Per worker: at most 5 + 10 PostgreSQL connections. Budget across ALL workers.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=2
DB_CONNECT_TIMEOUT_SECONDS=5
# Async admission leaves sync worker capacity available for response/cleanup work.
DB_MAX_CONCURRENT_SESSIONS=15
DB_ADMISSION_TIMEOUT_SECONDS=1
# Optional development bootstrap. Set both or neither; never use known production credentials.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
CORS_ORIGINS=["http://localhost:4173","http://localhost:4550","https://inkcollection.ir","https://www.inkcollection.ir"]
ML_MODEL_DIR=/app/ml/models
ML_CONFIDENCE_THRESHOLD=0.65
# Optional school demo accounts (emails are identifiers, not secrets):
# Manager: demo.school.manager2@example.com
# Secretary 1: demo.school.secretary2@example.com
# Secretary 2: demo.school.secretary3@example.com
# Set DEMO_IMPORT_PASSWORD privately in your server's environment, then rebuild/redeploy.
# Docker imports bundled demo accounts and school data into DATABASE_URL once at startup.
# All three NEW accounts use this password; local passwords are not transferred.
# Use a unique private 12–128 character password. Never commit the real value.
# Existing demo accounts, passwords, and data are preserved; this is not a password reset.
# Leave unset to disable importing. Remove it after the first successful import if desired.
# See docs/DEMO_DATABASE_IMPORT.md for details. Do not use demo credentials for real data.
# DEMO_IMPORT_PASSWORD=replace-with-a-new-private-demo-password
# Production must explicitly opt in before any new demo data is imported.
ALLOW_DEMO_DATA_IN_PRODUCTION=false
VITE_API_URL=http://localhost:8100/api/v1
